# Expression edge cases that should work
# Tests boundary conditions for expressions

# Division edge cases
@assert 1 / 2 == 0.5
@assert 1 / 3 * 3 == 1
@assert 10 / 3 == 10 / 3   # Exact rational comparison

# Modulo edge cases
@assert 8 % {1, 2, 3} == {0, 2}
@assert {10, 15, 20} % 5 == {0}

# Set arithmetic edge cases
@assert 1 - {1, 2, 3} == {0, -1, -2}
@assert 1 / {1, 2, 4} == {1, 0.5, 0.25}

# Empty vs non-empty set comparisons
@assert {1} < {1, 2}
@assert {1} <= {1}
@assert {1} != {1, 2}
@assert {1} >= {1}
@assert ({1, 2} > {1, 2}) == false
@assert {1, 2, 3} > {1, 2}

# Set with rationals
@assert {1, 5/2} == {-5/-2, 2.5, 1}

uint8 dummy
@sealed
